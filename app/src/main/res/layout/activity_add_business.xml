                    android:background="@drawable/white_shape_edit"
                    android:hint="@string/hint_business_email"
                    android:inputType="textEmailAddress"
                    android:paddingHorizontal="@dimen/_8ssp"
                    android:paddingVertical="@dimen/_8ssp"
                    app:fonts='@{"normal"}'
                    app:textSize='@{"font_body_s_size"}' />

                <TextView
                    android:id="@+id/textView12"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_5ssp"
                    android:text="@string/business_website"
                    android:textColor="@color/black"
                    app:fonts='@{"bold"}'
                    app:layout_constraintStart_toStartOf="@+id/etBusinessName"
                    app:layout_constraintTop_toBottomOf="@+id/etBusinessNumber"
                    app:textSize='@{"font_body_s_size"}' />

                <EditText
                    android:id="@+id/etBusinessWebsite"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_3ssp"
                    android:background="@drawable/white_shape_edit"
                    android:hint="@string/hint_business_website"
                    android:inputType="textWebEditText"
                    android:paddingHorizontal="@dimen/_8ssp"
                    android:paddingVertical="@dimen/_8ssp"
                    app:fonts='@{"normal"}'
                    app:textSize='@{"font_body_s_size"}' />

                <TextView
                    android:id="@+id/textView13"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_5ssp"
                    android:text="@string/business_address"
                    android:textColor="@color/black"
                    app:fonts='@{"bold"}'
                    app:layout_constraintStart_toStartOf="@+id/etBusinessName"
                    app:layout_constraintTop_toBottomOf="@+id/etBusinessNumber"
                    app:textSize='@{"font_body_s_size"}' />

                <EditText
                    android:id="@+id/etBusinessAddress"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_100ssp"
                    android:layout_marginTop="@dimen/_3ssp"
                    android:background="@drawable/white_shape_edit"
                    android:gravity="top"
                    android:hint="@string/hint_business_address"
                    android:inputType="textMultiLine"
                    android:lines="5"
                    android:paddingHorizontal="@dimen/_8ssp"
                    android:paddingVertical="@dimen/_8ssp"
                    app:fonts='@{"normal"}'
                    app:textSize='@{"font_body_s_size"}' />

                <Button
                    android:id="@+id/btn_save"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginVertical="@dimen/_10ssp"
                    android:backgroundTint="@color/blue_color"
                    android:paddingHorizontal="@dimen/_10ssp"
                    android:paddingVertical="@dimen/_8ssp"
                    android:text="@string/save"
                    android:textAllCaps="false"
                    android:textColor="@color/al_white"
                    app:fonts='@{"bold"}'
                    app:textSize='@{"button_text_16"}' />
-->
            </LinearLayout>

        </ScrollView>

        <LinearLayout
            android:id="@+id/ll_adview"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>